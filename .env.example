# Copy to `.env` and fill in values (same as web Client / Server).
#
# API_BASE_URL:
#   - Chrome / iOS Simulator on same Mac: http://localhost:5001
#   - Physical iPhone/Android on same Wi‑Fi: http://<YOUR_MAC_LAN_IP>:5001
#     e.g. http://192.168.100.23:5001  (run: ipconfig getifaddr en0)
#   - Google Play / production release: MUST be HTTPS (cleartext HTTP is blocked on modern Android).
#     e.g. https://api.your-domain.com
#   Rebuild / restart `flutter run` after changing .env (asset is baked into the app).
API_BASE_URL=http://localhost:5001
AES_KEY_HEX=your_64_char_hex_key_same_as_NEXT_PUBLIC_AES_KEY
# Optional; same as Server NEXTAUTH_SECRET (JWT signing — not used for login crypto).
NEXTAUTH_SECRET=your_nextauth_secret

# Attendance Plan B (Lambda emergency check-in when primary API is unavailable)
ATTENDANCE_PLAN_B_ENABLED=false
ATTENDANCE_PLAN_B_URL=

# App updates (optional). When LATEST_APP_VERSION > installed version, prompt to open store.
# Example: pubspec version is 1.0.0+1 → set LATEST_APP_VERSION=1.0.1 after you ship that build.
LATEST_APP_VERSION=
FORCE_APP_UPDATE=false
IOS_STORE_URL=
# After the Play listing exists:
# ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.hrs360.hrs360go
ANDROID_STORE_URL=
